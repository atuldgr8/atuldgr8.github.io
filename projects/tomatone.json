  {
   "id": "tt021t",
   "type": "text",
   "x": 270,
   "y": 1970,
   "w": 460,
   "h": 25.2,
   "text": "Deadline cliff and time agnosia",
   "weight": 700
  },
  {
   "id": "tt022t",
   "type": "text",
   "x": 270,
   "y": 2010,
   "w": 460,
   "h": 57.9,
   "text": "Time in ADHD is experienced in two states: 'now' and 'not now'. When an impending deadline is hours away, it feels distant; when it arrives, it creates an immediate crisis.",
   "size": "s"
  },
  {
   "id": "tt023g",
   "type": "group",
   "x": 270,
   "y": 2090,
   "w": 222,
   "h": 115,
   "children": [
    {
     "id": "tt023a",
     "type": "text",
     "x": 0,
     "y": 0,
     "w": 222,
     "h": 19.3,
     "text": "01",
     "size": "s",
     "color": "mute"
    },
    {
     "id": "tt023b",
     "type": "text",
     "x": 0,
     "y": 20,
     "w": 222,
     "h": 22,
     "text": "Alarm panic",
     "weight": 700
    },
    {
     "id": "tt023c",
     "type": "text",
     "x": 0,
     "y": 46,
     "w": 222,
     "h": 58,
     "text": "Sudden beeps trigger an acute fight-or-flight response, interrupting flow rather than closing it.",
     "size": "s"
    }
   ]
  },
  {
   "id": "tt024g",
   "type": "group",
   "x": 508,
   "y": 2090,
   "w": 222,
   "h": 115,
   "children": [
    {
     "id": "tt024a",
     "type": "text",
