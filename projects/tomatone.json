    {
     "id": "tt025b",
     "type": "text",
     "x": 0,
     "y": 20,
     "w": 222,
     "h": 22,
     "text": "Guilt mechanics",
     "weight": 700
    },
    {
     "id": "tt025c",
     "type": "text",
     "x": 0,
     "y": 46,
     "w": 222,
     "h": 58,
     "text": "Apps that kill virtual plants or dock points produce shame instead of sustainable habits.",
