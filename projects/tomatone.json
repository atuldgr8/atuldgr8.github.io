   "type": "text",
   "x": 270,
   "y": 4550,
   "w": 460,
   "h": 45,
   "text": "The parking-sensor insight: steady signals disappear. The change itself must be the signal, quickening as the deadline approaches.",
   "size": "s",
   "color": "mute"
  },
