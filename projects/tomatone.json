     "w": 222,
     "h": 19.3,
     "text": "02",
     "size": "s",
     "color": "mute"
    },
    {
     "id": "tt024b",
     "type": "text",
     "x": 0,
     "y": 20,
     "w": 222,
     "h": 22,
     "text": "Clock watching",
     "weight": 700
    },
    {
     "id": "tt024c",
     "type": "text",
     "x": 0,
     "y": 46,
     "w": 222,
     "h": 58,
     "text": "Visible countdown digits keep working memory vigilant and pull attention away from work.",
     "size": "s"
    }
   ]
  },
  {
   "id": "tt025g",
   "type": "group",
   "x": 746,
