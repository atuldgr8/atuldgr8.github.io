     "y": 0,
     "w": 222,
     "h": 19.3,
     "text": "Setting up",
     "size": "s",
     "color": "mute"
    },
    {
     "id": "tt073b",
     "type": "text",
     "x": 0,
     "y": 20,
     "w": 222,
     "h": 22,
     "text": "Rock forward / back",
     "weight": 700
    },
    {
     "id": "tt073c",
     "type": "text",
     "x": 0,
     "y": 46,
     "w": 222,
     "h": 77.9,
     "text": "+5 / −5 minutes per notch, mirrored live by the dial in the app. Set down to start.",
     "size": "s"
    }
   ]
  },
  {
