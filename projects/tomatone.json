   "type": "text",
   "x": 270,
   "y": 4730,
   "w": 460,
   "h": 25.2,
   "text": "Tactile physical companion",
   "weight": 700
  },
  {
   "id": "tt072t",
   "type": "text",
   "x": 270,
   "y": 4775,
   "w": 460,
   "h": 65,
   "text": "Tomatone is a screenless tactile cube with an internal inertial sensor. Because it has a front speaker grille, full rolls would muffle sound. All interactions use natural rocking and tilting gestures that always return to its feet.",
   "size": "s"
  },
  {
   "id": "tt073g",
   "type": "group",
   "x": 270,
   "y": 4860,
   "w": 222,
   "h": 135,
   "children": [
